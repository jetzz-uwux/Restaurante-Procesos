<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane
    styleClass="fondo-3"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="progs.restaurante.controllers.GerenteController">

    <children>

        <AnchorPane
            styleClass="panel-cristal"
            AnchorPane.bottomAnchor="10.0"
            AnchorPane.leftAnchor="10.0"
            AnchorPane.rightAnchor="10.0"
            AnchorPane.topAnchor="10.0">

            <children>

                <VBox alignment="CENTER"
                      maxHeight="-Infinity"
                      maxWidth="-Infinity"
                      minHeight="-Infinity"
                      minWidth="-Infinity"
                      prefHeight="600.0"
                      prefWidth="335.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0"
                      AnchorPane.rightAnchor="0.0"
                      AnchorPane.topAnchor="0.0">

                    <children>

                        <!-- BOTÓN AYUDA -->
                        <HBox alignment="CENTER_RIGHT"
                              prefHeight="29.0"
                              prefWidth="379.0">

                            <children>

                                <Button fx:id="btn_ayuda"
                                        contentDisplay="RIGHT"
                                        mnemonicParsing="false"
                                        styleClass="boton-imagen"
                                        text="Ayuda"
                                        HBox.hgrow="SOMETIMES">

                                    <graphic>

                                        <ImageView fitHeight="37.0"
                                                   fitWidth="37.0"
                                                   pickOnBounds="true"
                                                   preserveRatio="true">

                                            <image>
                                                <Image url="@../img/boton_i.png" />
                                            </image>

                                        </ImageView>

                                    </graphic>

                                </Button>

                            </children>

                        </HBox>

                        <!-- TEXTO BIENVENIDA -->
                        <HBox alignment="CENTER"
                              prefHeight="60.0"
                              prefWidth="379.0"
                              VBox.vgrow="SOMETIMES">

                            <children>

                                <Text strokeType="OUTSIDE"
                                      strokeWidth="0.0"
                                      text="Bienvenido/a, ">

                                    <styleClass>
                                        <String fx:value="texto-glow-verde" />
                                        <String fx:value="fuente-bouncy" />
                                    </styleClass>

                                    <font>
                                        <Font size="24.0" />
                                    </font>

                                </Text>

                                <Text strokeType="OUTSIDE"
                                      strokeWidth="0.0"
                                      text="[usuario]">

                                    <styleClass>
                                        <String fx:value="texto-glow-verde" />
                                        <String fx:value="fuente-bouncy" />
                                    </styleClass>

                                    <font>
                                        <Font size="24.0" />
                                    </font>

                                </Text>

                            </children>

                        </HBox>

                        <!-- BOTONES -->
                        <VBox alignment="CENTER"
                              VBox.vgrow="SOMETIMES">

                            <children>

                                <!-- REPORTES -->
                                <Button fx:id="btn_reportes"
                                        mnemonicParsing="false"
                                        onAction="#abrirReportes"
                                        prefWidth="250.0"
                                        style="-fx-font-size: 1.6em;"
                                        text="Reportes"
                                        VBox.vgrow="SOMETIMES">

                                    <VBox.margin>
                                        <Insets bottom="10.0" top="10.0" />
                                    </VBox.margin>

                                    <styleClass>
                                        <String fx:value="boton-glow-bubble-naranja" />
                                        <String fx:value="fuente-superchips" />
                                    </styleClass>

                                    <font>
                                        <Font size="20.0" />
                                    </font>

                                </Button>

                                <!-- INVENTARIO -->
                                <Button fx:id="btn_inventario"
                                        mnemonicParsing="false"
                                        onAction="#abrirInventario"
                                        prefWidth="250.0"
                                        style="-fx-font-size: 1.6em;"
                                        text="Inventario"
                                        VBox.vgrow="SOMETIMES">

                                    <styleClass>
                                        <String fx:value="boton-glow-bubble-naranja" />
                                        <String fx:value="fuente-superchips" />
                                    </styleClass>

                                    <font>
                                        <Font size="20.0" />
                                    </font>

                                    <VBox.margin>
                                        <Insets bottom="10.0" top="10.0" />
                                    </VBox.margin>

                                </Button>

                                <!-- GESTIÓN MENÚ -->
                                <Button mnemonicParsing="false"
                                        prefWidth="250.0"
                                        style="-fx-font-size: 1.6em;"
                                        text="Gestión de menú">

                                    <styleClass>
                                        <String fx:value="boton-glow-bubble-naranja" />
                                        <String fx:value="fuente-superchips" />
                                    </styleClass>

                                    <font>
                                        <Font size="20.0" />
                                    </font>

                                    <VBox.margin>
                                        <Insets bottom="10.0" top="10.0" />
                                    </VBox.margin>

                                </Button>

                                <!-- EMPLEADOS -->
                                <Button mnemonicParsing="false"
                                        prefWidth="250.0"
                                        style="-fx-font-size: 1.6em;"
                                        text="Empleados">

                                    <styleClass>
                                        <String fx:value="boton-glow-bubble-naranja" />
                                        <String fx:value="fuente-superchips" />
                                    </styleClass>

                                    <font>
                                        <Font size="20.0" />
                                    </font>

                                    <VBox.margin>
                                        <Insets bottom="10.0" top="10.0" />
                                    </VBox.margin>

                                </Button>

                                <!-- CONTROL ASISTENCIA -->
                                <Button mnemonicParsing="false"
                                        prefWidth="250.0"
                                        style="-fx-font-size: 1.6em;"
                                        text="Control de asistencia">

                                    <styleClass>
                                        <String fx:value="boton-glow-bubble-naranja" />
                                        <String fx:value="fuente-superchips" />
                                    </styleClass>

                                    <font>
                                        <Font size="20.0" />
                                    </font>

                                    <VBox.margin>
                                        <Insets bottom="10.0" top="10.0" />
                                    </VBox.margin>

                                </Button>

                                <!-- IMAGEN -->
                                <ImageView fitHeight="193.0"
                                           fitWidth="203.0"
                                           pickOnBounds="true"
                                           preserveRatio="true">

                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin>

                                </ImageView>

                            </children>

                        </VBox>

                        <!-- BOTÓN CERRAR -->
                        <HBox alignment="BOTTOM_LEFT"
                              prefHeight="29.0"
                              prefWidth="379.0"
                              VBox.vgrow="SOMETIMES">

                            <children>

                                <Button fx:id="btn_cerrarsesion"
                                        mnemonicParsing="false"
                                        onAction="#cerrarSesion"
                                        styleClass="boton-imagen"
                                        HBox.hgrow="SOMETIMES">

                                    <graphic>

                                        <ImageView fitHeight="49.0"
                                                   fitWidth="51.0"
                                                   pickOnBounds="true"
                                                   preserveRatio="true">

                                            <image>
                                                <Image url="@../img/boton_X.png" />
                                            </image>

                                        </ImageView>

                                    </graphic>

                                </Button>

                            </children>

                        </HBox>

                    </children>

                </VBox>

            </children>

        </AnchorPane>

    </children>

</AnchorPane>