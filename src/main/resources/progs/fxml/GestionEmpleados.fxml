<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    ARCHIVO FXML - GESTION DE EMPLEADOS
    Este archivo define la ESTRUCTURA VISUAL de la pantalla.
    SceneBuilder lo genera/edita visualmente.

    IMPORTANTE:
    fx:controller apunta a tu clase controladora
    fx:id         conecta cada elemento con una variable @FXML del controlador
    onAction      conecta cada boton con un metodo @FXML del controlador
-->

<BorderPane prefHeight="600" prefWidth="960" styleClass="root-pane" stylesheets="@GestionEmpleados.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="progs.restaurante.controllers.GestionEmpleadosController">

    <!-- ENCABEZADO SUPERIOR: Titulo de la pantalla -->
    <top>
        <VBox alignment="CENTER" styleClass="header-bar">
            <Label text="CENTRAL DE PERSONAL">
            <styleClass>
               <String fx:value="titulo-principal" />
               <String fx:value="fuente-bouncy" />
            </styleClass></Label>
            <Label styleClass="subtitulo" text="Sistema de Gestion de Personal" />
        </VBox>
    </top>

    <!-- CONTENIDO CENTRAL: Tabla izquierda mas Panel derecho -->
    <center>
        <HBox spacing="20" styleClass="contenido-central">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- PANEL IZQUIERDO: Tabla de Personal Activo -->
            <VBox spacing="10" styleClass="panel-tabla" HBox.hgrow="ALWAYS">

                <!-- Titulo del panel izquierdo con contador -->
                <HBox alignment="CENTER" styleClass="panel-encabezado">
                    <Label styleClass="icono-panel" text="PERSONAL " />
                    <Label fx:id="lblContador" styleClass="titulo-panel" text="PERSONAL ACTIVO (0)" />
                </HBox>

                <!-- Tabla de empleados -->
                <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS">
                    <columns>
                        <!-- Columna ID -->
                        <TableColumn fx:id="colId" prefWidth="60" styleClass="col-id" text="ID" />

                        <!-- Columna Nombre -->
                        <TableColumn fx:id="colNombre" prefWidth="160" text="Nombre" />

                        <!-- Columna Usuario -->
                        <TableColumn fx:id="colUsuario" prefWidth="130" text="Usuario" />

                        <!-- Columna Rol con badges de color -->
                        <TableColumn fx:id="colRol" prefWidth="150" text="Rol / Puesto" />
                    </columns>

                    <!-- Mensaje cuando la tabla esta vacia -->
                    <placeholder>
                        <Label styleClass="tabla-vacia" text="No hay empleados registrados" />
                    </placeholder>
               <styleClass>
                  <String fx:value="tabla-empleados" />
                  <String fx:value="fuente-somelist" />
               </styleClass>
                </TableView>

            </VBox>

            <!-- PANEL DERECHO: Formulario de Accion -->
            <VBox prefWidth="340" spacing="14" styleClass="panel-accion">

                <!-- Titulo del panel derecho -->
                <HBox alignment="CENTER" styleClass="panel-encabezado">
                    <Label styleClass="titulo-panel" text="PANEL DE ACCION" />
                </HBox>

                <!-- Subtitulo dinamico: muestra que empleado se edita -->
                <Label fx:id="lblTituloPanel" styleClass="subtitulo-panel" text="NUEVO EMPLEADO" wrapText="true" />

                <!-- SEPARADOR VISUAL -->
                <Separator styleClass="separador" />

                <!-- CAMPO: Nombre -->
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="etiqueta-campo" text="Nombre" />
                    </HBox>
                    <TextField fx:id="txtNombre" promptText="Ej: Juan Lopez" styleClass="campo-texto" />
                </VBox>

                <!-- CAMPO: Usuario -->
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="etiqueta-campo" text="Usuario" />
                    </HBox>
                    <TextField fx:id="txtUsuario" promptText="Ej: jlopez2024" styleClass="campo-texto" />
                </VBox>

                <!-- CAMPO: Contrasena -->
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="etiqueta-campo" text="Contrasena" />
                    </HBox>
                    <PasswordField fx:id="txtContrasena" promptText="Dejar vacio para no cambiar" styleClass="campo-texto" />
                </VBox>

                <!-- CAMPO: Rol / Puesto -->
                <VBox spacing="4">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label styleClass="etiqueta-campo" text="Rol / Puesto" />
                    </HBox>
                    <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Selecciona un rol" styleClass="combo-rol" />
                </VBox>

                <!-- SEPARADOR ANTES DE BOTONES -->
                <Separator styleClass="separador" />

                <!-- BOTONES DE ACCION: Contratar / Actualizar / Despedir -->
                <HBox alignment="CENTER" spacing="10">

                    <!-- BOTON VERDE: ALTA / CONTRATAR -->
                    <VBox alignment="CENTER" spacing="4">
                        <Button fx:id="btnContratar" onAction="#accionContratar" prefHeight="55" prefWidth="90" styleClass="btn-contratar" text="[+]" />
                        <Label styleClass="etiqueta-boton" text="CONTRATAR" />
                        <Label styleClass="etiqueta-boton-sub" text="(Alta)" />
                    </VBox>

                    <!-- BOTON AMARILLO: MODIFICAR / ACTUALIZAR -->
                    <VBox alignment="CENTER" spacing="4">
                        <Button fx:id="btnActualizar" onAction="#accionActualizar" prefHeight="55" prefWidth="90" styleClass="btn-actualizar" text="[=]" />
                        <Label styleClass="etiqueta-boton" text="ACTUALIZAR" />
                        <Label styleClass="etiqueta-boton-sub" text="(Modificar)" />
                    </VBox>

                    <!-- BOTON ROJO: BAJA / DESPEDIR -->
                    <VBox alignment="CENTER" spacing="4">
                        <Button fx:id="btnDespedir" onAction="#accionDespedir" prefHeight="55" prefWidth="90" styleClass="btn-despedir" text="[x]" />
                        <Label styleClass="etiqueta-boton" text="DESPEDIR" />
                        <Label styleClass="etiqueta-boton-sub" text="(Baja)" />
                    </VBox>

                </HBox>

                <!-- BOTON GRIS: LIMPIAR FORMULARIO -->
                <Button maxWidth="Infinity" onAction="#limpiarFormulario" styleClass="btn-limpiar" text="Limpiar / Nuevo" />

            </VBox>

        </HBox>
    </center>

</BorderPane>
