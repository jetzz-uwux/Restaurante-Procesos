<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="541.0" prefWidth="682.0" spacing="10" styleClass="fondo-7" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="progs.restaurante.controllers.VentanaVentasController">

    <Label styleClass="fuente-bouncy" text="Reporte de Ventas">
      <font>
         <Font size="22.0" />
      </font></Label>
   <StackPane styleClass="stackpane-tabla">
      <children>
      
          <TableView fx:id="tbl_ventas" style="-fx-background-color: transparent;">
              <columns>
                  <TableColumn fx:id="col_id" text="ID Venta" />
                  <TableColumn fx:id="col_pedido" text="Pedido" />
                  <TableColumn fx:id="col_mesa" text="Mesa" />
                  <TableColumn fx:id="col_total" text="Total" />
                  <TableColumn fx:id="col_fecha" text="Fecha y Hora" />
              </columns>
            <StackPane.margin>
               <Insets bottom="70.0" left="40.0" right="40.0" top="30.0" />
            </StackPane.margin>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
          </TableView>
      </children>
   </StackPane>

</VBox>
