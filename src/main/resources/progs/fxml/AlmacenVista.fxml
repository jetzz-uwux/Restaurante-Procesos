<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="progs.restaurante.controllers.AlmacenController">

    <top>
        <Label style="-fx-font-size: 20px; -fx-padding: 10;" text="Inventario de Materia Prima" />
    </top>

    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre" />
                <TableColumn fx:id="colCantidad" prefWidth="120" text="Cantidad" />
                <TableColumn fx:id="colUnidad" prefWidth="120" text="Unidad" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10">
                <TextField fx:id="txtNombre" promptText="Nombre" />
                <TextField fx:id="txtCantidad" promptText="Cantidad" />
                <TextField fx:id="txtUnidad" promptText="Unidad" />
            </HBox>

            <HBox spacing="10">
                <Button onAction="#agregar" text="Agregar" />
                <Button onAction="#editar" text="Editar" />
                <Button onAction="#eliminar" text="Eliminar" />
                <Button onAction="#limpiarCampos" text="Limpiar" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
