<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="fondo-7" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="progs.restaurante.controllers.AlmacenController">

    <top>
        <Label style="-fx-font-size: 20px; -fx-padding: 10;" styleClass="fuente-bouncy" text="Inventario de Materia Prima" />
    </top>

    <center>
      <StackPane styleClass="stackpane-tabla">
         <children>
              <TableView fx:id="tabla" style="-fx-background-color: transparent;">
                  <columns>
                      <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre" />
                      <TableColumn fx:id="colCantidad" prefWidth="120" text="Cantidad" />
                      <TableColumn fx:id="colUnidad" prefWidth="120" text="Unidad" />
                  </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <StackPane.margin>
                  <Insets bottom="100.0" left="50.0" right="50.0" top="20.0" />
               </StackPane.margin>
              </TableView>
         </children>
      </StackPane>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10">
                <TextField fx:id="txtNombre" promptText="Nombre" styleClass="textfield-overcooked" />
                <TextField fx:id="txtCantidad" promptText="Cantidad" styleClass="textfield-overcooked" />
                <TextField fx:id="txtUnidad" promptText="Unidad" styleClass="textfield-overcooked" />
            </HBox>

            <HBox spacing="10">
                <Button onAction="#agregar" styleClass="boton-glow-bubble-azul" text="Agregar" />
                <Button onAction="#editar" styleClass="boton-glow-bubble-azul" text="Editar" />
                <Button onAction="#eliminar" styleClass="boton-glow-bubble-azul" text="Eliminar" />
                <Button onAction="#limpiarCampos" styleClass="boton-glow-bubble-azul" text="Limpiar" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
