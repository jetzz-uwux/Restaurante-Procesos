<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" styleClass="fondo-7" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="progs.restaurante.controllers.AsistenciaController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="titulo-login" text="Asistencia de Empleados" />

    <TextField fx:id="txtUsuario" maxWidth="250" promptText="Usuario del empleado" styleClass="campo-texto" />

    <PasswordField fx:id="txtContrasena" maxWidth="250" promptText="Contraseña" styleClass="campo-texto" />

    <Button maxWidth="250" onAction="#marcarAsistencia" styleClass="boton-glow-bubble-azul" text="Marcar asistencia" />

    <Label fx:id="lblMensaje" style="-fx-font-size: 14px;" />

</VBox>
