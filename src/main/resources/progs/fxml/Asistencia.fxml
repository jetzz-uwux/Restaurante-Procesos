<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="progs.restaurante.controllers.AsistenciaController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Asistencia de Empleados"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <TextField fx:id="txtNombre"
               promptText="Nombre del empleado"
               maxWidth="250"/>

    <PasswordField fx:id="txtContrasena"
                   promptText="Contraseña"
                   maxWidth="250"/>

    <Button text="Marcar asistencia"
            onAction="#marcarAsistencia"
            maxWidth="250"/>

    <Label fx:id="lblMensaje"
           style="-fx-font-size: 14px;"/>

</VBox>