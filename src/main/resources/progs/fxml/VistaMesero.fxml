<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    VistaMesero.fxml — ATENCION A MESAS
    Rediseñado para coincidir con la imagen de referencia:
    Titulo con fondo madera, 3 botones circulares grandes (Pedidos, Cerrar Cuenta, Notificaciones),
    tabla inferior con No.Mesa / No.Pedido / Estado,
    y dos botones laterales: Orden Lista y Editar Pedido.
    Botones de esquina: Ayuda (arriba izq) y Cerrar sesion (arriba der).
-->

<AnchorPane prefHeight="520.0" prefWidth="750.0" styleClass="fondo-madera" stylesheets="@VistaMesero.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="progs.restaurante.controllers.VistaMeseroController">

    <children>

        <!-- PANEL PRINCIPAL: Marco interior con fondo beige/madera clara -->
        <AnchorPane styleClass="panel-marco" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">

            <children>

                <!-- BOTON AYUDA: esquina superior izquierda -->
                <VBox alignment="CENTER" styleClass="boton-esquina-izq" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0">
                    <Button fx:id="btn_ayuda" mnemonicParsing="false" styleClass="boton-imagen">
                  <graphic>
                     <ImageView fitHeight="50.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../img/icono_i.png" />
                        </image>
                     </ImageView>
                  </graphic></Button>
                </VBox>

                <!-- BOTON CERRAR SESION: esquina superior derecha (X roja) -->
                <Button fx:id="btn_cerrarsesion" mnemonicParsing="false" onAction="#handleCerrarSesion" styleClass="boton-imagen" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
               <graphic>
                  <ImageView fitHeight="56.0" fitWidth="86.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../img/icono_cerrar.png" />
                     </image>
                  </ImageView>
               </graphic></Button>

                <!-- TITULO PRINCIPAL -->
                <HBox alignment="CENTER" AnchorPane.leftAnchor="70.0" AnchorPane.rightAnchor="70.0" AnchorPane.topAnchor="12.0">
                    <Label text="ATENCIóN A MESAS">
                  <styleClass>
                     <String fx:value="titulo-principal-mesero" />
                     <String fx:value="fuente-bouncy" />
                  </styleClass></Label>
                </HBox>

                <!-- CONTENIDO PRINCIPAL: botones grandes + tabla + botones laterales -->
                <VBox spacing="14.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="70.0">

                    <!-- FILA 1: Los 3 botones circulares grandes -->
                    <HBox alignment="CENTER" spacing="30.0">
                         <Button fx:id="btn_pedidos" mnemonicParsing="false" onAction="#handlePedidos" prefHeight="130.0" prefWidth="130.0" styleClass="boton-imagen">
                     <graphic>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../img/boton_pedidos.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                         <Button fx:id="btn_cerrarCuenta" mnemonicParsing="false" onAction="#handleCerrarCuenta" prefHeight="140.0" prefWidth="140.0" styleClass="boton-imagen">
                     <graphic>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../img/boton_cerrarcuenta.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                         <StackPane>
                             <Button fx:id="btn_notificaciones" mnemonicParsing="false" onAction="#handleNotificaciones" prefHeight="130.0" prefWidth="130.0" styleClass="boton-imagen">
                        <graphic>
                           <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../img/boton_notificacion.png" />
                              </image>
                           </ImageView>
                        </graphic>
                     </Button>
                             <!-- Badge con contador de notificaciones -->
                             <StackPane fx:id="badge_campana" alignment="TOP_RIGHT" managed="false" pickOnBounds="false" visible="false">
                                 <Label fx:id="lbl_campana" styleClass="badge-campana" text="0" StackPane.alignment="TOP_RIGHT" />
                             </StackPane>
                         </StackPane>
                  <Button fx:id="btn_asistencia" mnemonicParsing="false" onAction="#handleAsistencia" prefHeight="140.0" prefWidth="140.0" styleClass="boton-imagen">
                     <graphic>
                        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../img/boton_registroasistencias.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>

                    </HBox>

                    <!-- FILA 2: Tabla + Botones laterales -->
                    <HBox spacing="12.0" VBox.vgrow="ALWAYS">

                        <!-- TABLA de pedidos activos -->
                        <VBox styleClass="contenedor-tabla" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

                            <!-- Encabezados manuales de la tabla (estilo imagen: tickets) -->
                            <HBox spacing="0.0" styleClass="fila-encabezado-tabla">
                                <Label prefWidth="150.0" styleClass="encabezado-col" text="No. Mesa" />
                                <Label prefWidth="150.0" styleClass="encabezado-col" text="No. Pedido" />
                                <Label prefWidth="150.0" styleClass="encabezado-col" text="Estado" />
                            </HBox>

                            <!-- Tabla real de JavaFX -->
                            <TableView fx:id="tablaPedidos" styleClass="tabla-pedidos" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colMesa" prefWidth="140.0" text="Mesa" />
                                    <TableColumn fx:id="colPedido" prefWidth="140.0" text="Pedido" />
                                    <TableColumn fx:id="colEstado" prefWidth="140.0" text="Estado" />
                                </columns>
                                <placeholder>
                                    <Label styleClass="tabla-vacia" text="Sin pedidos activos" />
                                </placeholder>
                            </TableView>
                        </VBox>

                        <!-- BOTONES LATERALES DERECHOS -->
                        <VBox alignment="CENTER" spacing="12.0">
                            <!-- BOTON ORDEN LISTA (verde) -->
                            <Button fx:id="btn_ordenLista" mnemonicParsing="false" prefHeight="55.0" prefWidth="130.0" styleClass="btn-lateral-verde" text="ORDEN LISTA" wrapText="true" />

                            <!-- BOTON EDITAR PEDIDO (rojo) -->
                            <Button fx:id="btn_editarPedido" mnemonicParsing="false" prefHeight="55.0" prefWidth="130.0" styleClass="btn-lateral-rojo" text="EDITAR PEDIDO" wrapText="true" />
                        </VBox>

                    </HBox>

                </VBox>

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
