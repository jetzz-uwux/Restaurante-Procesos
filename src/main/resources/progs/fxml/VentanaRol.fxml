<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="300.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="progs.restaurante.controllers.SelectorRolController">
    <children>
        <VBox alignment="CENTER" spacing="30.0" styleClass="fondo-7" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <Label styleClass="titulo-dialogo" text="Bienvenito a Tacos Juanito" />
                <Label styleClass="campo-label" text="Por favor, selecciona tu tipo de acceso para continuar:" />
            
                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <Button fx:id="btn_acceso_cliente" mnemonicParsing="false" prefHeight="50.0" prefWidth="160.0" styleClass="boton-glow-bubble-naranja" text="Soy Cliente" />
                        <Button fx:id="btn_acceso_empleado" mnemonicParsing="false" prefHeight="50.0" prefWidth="160.0" styleClass="boton-glow-bubble-azul" text="Soy Empleado" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
